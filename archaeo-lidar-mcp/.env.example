# Directorios de trabajo
DATA_DIR=./data/raw
PROCESSED_DIR=./data/processed
REPORTS_DIR=./data/reports

# Configuración de red y endpoints externos
HTTP_TIMEOUT_SECONDS=25.0
IGN_WFS_URL=https://wms.ign.gob.ar/geoserver/ows
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPENALEX_API_URL=https://api.openalex.org/works
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1/paper/search

# Capa local opcional de sitios arqueológicos registrados (GeoPackage)
KNOWN_SITES_GPKG_PATH=./data/known_sites.gpkg

# Proveedores multisatélite (DEM + Óptico/Multiespectral + SAR)
DEM_PROVIDER=auto
DEM_FALLBACK_CHAIN=["ign_wcs","fabdem","copernicus_aws","planetary_stac"]
OPTICAL_PROVIDER=sentinel2_stac
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
PLANETARY_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
FABDEM_STAC_OR_GEE_COLLECTION=projects/sat-io/open-datasets/FABDEM
XYZ_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Credenciales opcionales (solo si se usan conectores GEE o ASF SAR)
# GEE_PROJECT_ID=mi-proyecto-gee
# ASF_EARTHDATA_TOKEN=

# Topes de tamaño y presupuesto de red/RAM
MAX_MASTER_SIDE_PX=4096
MAX_OPTICAL_CHIP_PX=512
OPTICAL_BUFFER_M=150.0
